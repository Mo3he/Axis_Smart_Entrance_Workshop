        "name": "Text to object",
        "func": "// \"root.Brand.ProdNbr=P1475-LE\" -> { \"Brand.ProdNbr\": \"P1475-LE\" }\nconst info = {};\nfor (const line of msg.payload.trim().split('\\n')) {\n    const [key, ...value] = line.split('=');\n    info[key.replace('root.', '')] = value.join('=');\n}\nmsg.payload = info;\nreturn msg;",
