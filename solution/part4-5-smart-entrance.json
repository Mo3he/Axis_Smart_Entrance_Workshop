    {
        "id": "a4b0000000000030",
        "type": "function",
        "z": "f2a0000000000041",
        "name": "Normalize + append event log",
        "func": "let p = msg.payload;\nif (typeof p === 'string') {\n    try { p = JSON.parse(p); }\n    catch (e) { p = { detail: p }; }\n}\nif (!p || typeof p !== 'object') p = { detail: String(p) };\nconst event = p.event || 'unknown';\nconst entry = {\n    time: new Date().toLocaleString('it-IT'),\n    source: p.source || 'unknown',\n    event,\n    severity: p.severity || 'info',\n    detail: p.detail || ''\n};\nlet log = flow.get('eventLog') || [];\nlog.unshift(entry);\nlog = log.slice(0, 25);\nflow.set('eventLog', log);\nmsg.payload = entry;\nreturn [msg, { payload: log }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 340,
        "wires": [["a4b0000000000031"], ["a4b0000000000032"]]
    },
